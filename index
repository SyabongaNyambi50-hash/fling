<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Goodnight ❤️</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Outfit:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #0b0d19;
            color: #f3e8ee;
            font-family: 'Outfit', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            position: relative;
        }

        /* Moon Glow Effect */
        .moon-glow {
            position: fixed;
            top: -100px;
            right: -100px;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(224, 185, 233, 0.22) 0%, rgba(131, 105, 186, 0.08) 50%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
            filter: blur(40px);
        }

        /* Starry Canvas */
        #starsCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        /* Main Glassmorphism Card Container */
        .card-container {
            position: relative;
            z-index: 2;
            width: 90%;
            max-width: 480px;
            margin: 30px 15px;
            padding: 45px 30px;
            background: rgba(22, 20, 38, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7),
                        0 0 30px rgba(183, 138, 224, 0.12);
            text-align: center;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInCard 1.4s ease-out forwards;
        }

        /* Animated Moon Icon */
        .moon-icon {
            font-size: 2.8rem;
            display: inline-block;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 12px rgba(247, 212, 136, 0.5));
            animation: float 4s ease-in-out infinite;
        }

        /* Main Greeting Headline */
        .title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 25px;
            letter-spacing: -0.5px;
        }

        .title span {
            color: #f1b3cc;
            font-style: italic;
        }

        /* Flirty Romantic Note Body */
        .note-body {
            font-size: 1.12rem;
            line-height: 1.8;
            color: #dcd6e2;
            font-weight: 300;
            margin-bottom: 30px;
        }

        .note-body p {
            margin-bottom: 18px;
        }

        .highlight-text {
            color: #ffb7c5;
            font-weight: 400;
        }

        /* Secret Tap Reveal Box */
        .secret-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px dashed rgba(241, 179, 204, 0.4);
            border-radius: 16px;
            padding: 18px 20px;
            margin: 25px 0 30px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            user-select: none;
        }

        .secret-box:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(241, 179, 204, 0.8);
            transform: translateY(-2px);
        }

        .secret-hint {
            font-size: 0.92rem;
            color: #c0b8cc;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .secret-content {
            display: none;
            font-family: 'Caveat', cursive;
            font-size: 1.65rem;
            color: #ffccd5;
            line-height: 1.4;
            animation: popIn 0.5s ease-out forwards;
        }

        /* Interactive Dream Button */
        .action-btn {
            background: linear-gradient(135deg, #e27d93 0%, #a259bb 100%);
            border: none;
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 500;
            padding: 15px 32px;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(226, 125, 147, 0.35);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .action-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 30px rgba(226, 125, 147, 0.5);
        }

        .action-btn:active {
            transform: scale(0.98);
        }

        /* Toast Popup Notification */
        .toast {
            position: fixed;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(255, 255, 255, 0.95);
            color: #1a162b;
            padding: 12px 24px;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 500;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            z-index: 10;
            pointer-events: none;
            white-space: nowrap;
        }

        .toast.show {
            bottom: 30px;
        }

        /* Keyframe Animations */
        @keyframes fadeInCard {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(4deg); }
        }

        @keyframes popIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Responsive Tweaks */
        @media (max-width: 480px) {
            .card-container {
                padding: 35px 20px;
            }
            .title {
                font-size: 1.75rem;
            }
            .note-body {
                font-size: 1.05rem;
            }
        }
    </style>
</head>
<body>

    <div class="moon-glow"></div>
    <canvas id="starsCanvas"></canvas>

    <div class="card-container">
        <div class="moon-icon">🌙</div>
        
        <h1 class="title">Goodnight, <span>Beautiful</span></h1>

        <div class="note-body">
            <p>I was just about to go to bed, but you popped into my head... <span class="highlight-text">as you always do</span>.</p>
            <p>I hope your day was as incredible as you are, and that tonight brings you the softest, most peaceful sleep.</p>
            <p>Sleep well, close your eyes, and try not to think about me <em>too</em> much tonight... 😉</p>
        </div>

        <!-- Tap to Reveal Secret Message -->
        <div class="secret-box" id="secretBox">
            <div class="secret-hint" id="secretHint">
                ✨ <span>Tap to reveal a bedtime secret</span> ✨
            </div>
            <div class="secret-content" id="secretContent">
                "I'll be looking out for you in my dreams tonight... save a spot for me? ❤️"
            </div>
        </div>

        <!-- Interactive Nighty Night Button -->
        <button class="action-btn" id="dreamBtn">Send a Goodnight Kiss 💋</button>
    </div>

    <div class="toast" id="toast">Kiss sent! Sweet dreams tonight ✨</div>

    <script>
        // Starry Night Sky Canvas Animation
        const canvas = document.getElementById('starsCanvas');
        const ctx = canvas.getContext('2d');

        let stars = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            initStars();
        }

        window.addEventListener('resize', resizeCanvas);

        class Star {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 1.8 + 0.3;
                this.alpha = Math.random();
                this.speed = Math.random() * 0.015 + 0.005;
                this.dir = Math.random() > 0.5 ? 1 : -1;
            }

            update() {
                this.alpha += this.speed * this.dir;
                if (this.alpha >= 0.95) this.dir = -1;
                if (this.alpha <= 0.1) this.dir = 1;
            }

            draw() {
                ctx.fillStyle = `rgba(255, 230, 245, ${this.alpha})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function initStars() {
            stars = [];
            const count = Math.floor((canvas.width * canvas.height) / 3000);
            for (let i = 0; i < count; i++) {
                stars.push(new Star());
            }
        }

        function animateStars() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(star => {
                star.update();
                star.draw();
            });
            requestAnimationFrame(animateStars);
        }

        resizeCanvas();
        animateStars();

        // Secret Note Toggle
        const secretBox = document.getElementById('secretBox');
        const secretHint = document.getElementById('secretHint');
        const secretContent = document.getElementById('secretContent');

        secretBox.addEventListener('click', () => {
            secretHint.style.display = 'none';
            secretContent.style.display = 'block';
            secretBox.style.borderColor = 'rgba(241, 179, 204, 0.8)';
            secretBox.style.background = 'rgba(255, 255, 255, 0.08)';
        });

        // Interactive Kiss Button & Toast Trigger
        const dreamBtn = document.getElementById('dreamBtn');
        const toast = document.getElementById('toast');

        dreamBtn.addEventListener('click', (e) => {
            // Show toast message
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);

            // Floating hearts animation from button position
            const rect = dreamBtn.getBoundingClientRect();
            for (let i = 0; i < 8; i++) {
                createFloatingHeart(rect.left + rect.width / 2, rect.top);
            }
        });

        function createFloatingHeart(x, y) {
            const heart = document.createElement('div');
            heart.innerHTML = '✨❤️';
            heart.style.position = 'fixed';
            heart.style.left = `${x + (Math.random() - 0.5) * 40}px`;
            heart.style.top = `${y}px`;
            heart.style.fontSize = `${Math.random() * 12 + 16}px`;
            heart.style.pointerEvents = 'none';
            heart.style.zIndex = '100';
            heart.style.transition = 'all 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
            heart.style.opacity = '1';

            document.body.appendChild(heart);

            requestAnimationFrame(() => {
                heart.style.transform = `translate(${(Math.random() - 0.5) * 100}px, -${Math.random() * 100 + 100}px) scale(1.3)`;
                heart.style.opacity = '0';
            });

            setTimeout(() => {
                heart.remove();
            }, 1500);
        }
    </script>
</body>
</html>
